# ==============================================================================
# GARVIX Production Environment Variables (.env) for Hostinger VPS
# ==============================================================================

# Database Connection String (PostgreSQL on local VPS)
DATABASE_URL="postgresql://garvix_user:StrongPassword123@localhost:5432/garvix_db?schema=public"

# Production JWT Secret (Generate a strong random string)
JWT_SECRET="garvix-prod-jwt-super-secret-key-change-this-in-production"

# Telegram Bot Integration for Live Leads
# Token from @BotFather, Chat ID from @userinfobot or your admin channel
TELEGRAM_BOT_TOKEN="your_actual_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_or_channel_id"

# Company GST & Business Profile (Haryana State Code 06)
NEXT_PUBLIC_COMPANY_NAME="GARVIX TECHNOLOGIES"
NEXT_PUBLIC_COMPANY_TAGLINE="Next-Gen RFID Ecosystems & Bespoke Software"
NEXT_PUBLIC_COMPANY_STATE="Haryana"
NEXT_PUBLIC_COMPANY_STATE_CODE="06"
NEXT_PUBLIC_COMPANY_GSTIN="06AAACG1234F1Z5"
NEXT_PUBLIC_COMPANY_EMAIL="contact@garvix.in"
NEXT_PUBLIC_COMPANY_PHONE="+91 98765 43210"
NEXT_PUBLIC_COMPANY_ADDRESS="Cyber Hub, Sector 24, Gurugram, Haryana - 122002"

# Dynamic UPI QR Code Parameters (Auto-rendered on Tax Invoices)
NEXT_PUBLIC_UPI_ID="garvix@upi"
NEXT_PUBLIC_UPI_NAME="GARVIX TECHNOLOGIES"

# Next.js Production Environment
NODE_ENV="production"
PORT=3000
